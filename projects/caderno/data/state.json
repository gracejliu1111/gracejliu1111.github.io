{"v": 2, "updatedAt": 1, "book": {"title": "Essential Brazilian Portuguese", "author": "Living Language — Dulce Marcello"}, "chapters": [{"id": "mtdbrkhf2s2ai", "num": "1", "title": "Essential Expressions", "pages": "9–23", "created": "2026-08-28"}], "vocab": [{"id": "mtdbrkhf107rn", "chapterId": "mtdbrkhf2s2ai", "pt": "oi", "en": "hi", "ex": "Oi, Gustavo. E aí?", "tags": ["greetings", "lesson 1"], "box": 0, "reviews": 0, "right": 0, "lapses": 0, "created": "2026-08-28", "audio": null}, {"id": "mtdbrkhf3rrd1", "chapterId": "mtdbrkhf2s2ai", "pt": "bom dia", "en": "good morning", "ex": "Bom dia, tudo bem?", "tags": ["greetings", "lesson 1"], "box": 0, "reviews": 0, "right": 0, "lapses": 0, "created": "2026-08-28", "audio": null}, {"id": "mtdbrkhfk7sqk", "chapterId": "mtdbrkhf2s2ai", "pt": "boa tarde", "en": "good afternoon", "ex": "", "tags": ["greetings", "lesson 1"], "box": 0, "reviews": 0, "right": 0, "lapses": 0, "created": "2026-08-28", "audio": null}, {"id": "mtdbrkhf6ghbk", "chapterId": "mtdbrkhf2s2ai", "pt": "boa noite", "en": "good evening/good night", "ex": "Boa noite, como vai a senhora?", "tags": ["greetings", "lesson 1"], "box": 0, "reviews": 0, "right": 0, "lapses": 0, "created": "2026-08-28", "audio": null}, {"id": "mtdbrkhfe3rkd", "chapterId": "mtdbrkhf2s2ai", "pt": "Tudo bem?", "en": "How's it going? (infml.)", "ex": "", "tags": ["greetings", "lesson 1"], "box": 0, "reviews": 0, "right": 0, "lapses": 0, "created": "2026-08-28", "audio": null}, {"id": "mtdbrkhfkulcj", "chapterId": "mtdbrkhf2s2ai", "pt": "Tudo bem.", "en": "I'm fine. (infml.)", "ex": "Oi, Sandra. Tudo bem.", "tags": ["greetings", "lesson 1"], "box": 0, "reviews": 0, "right": 0, "lapses": 0, "created": "2026-08-28", "audio": null}, {"id": "mtdbrkhfggtiu", "chapterId": "mtdbrkhf2s2ai", "pt": "Como vai?", "en": "How are you? (fml.)", "ex": "", "tags": ["greetings", "lesson 1"], "box": 0, "reviews": 0, "right": 0, "lapses": 0, "created": "2026-08-28", "audio": null}, {"id": "mtdbrkhf6pjlm",