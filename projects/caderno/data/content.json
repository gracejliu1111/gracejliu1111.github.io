 "notes": [
  {
   "chapterId": "ch-alfabeto",
   "title": "O alfabeto",
   "source": "p. —",
   "blocks": [
    {
     "t": "p",
     "text": "Twenty-six letters, the same as English. Say the name of each one out loud — you will need them for spelling your name on the phone, and the names are not what an English speaker guesses. Tap the microphone on any letter to record it."
    },
    {
     "t": "callout",
     "text": "K, W and Y were readmitted to the alphabet by the 2009 spelling reform. They appear almost only in foreign names, units and borrowed words, so learn them last."
    },
    {
     "t": "h",
     "text": "The letters"
    },
    {
     "t": "alpha",
     "tag": "alfabeto",
     "rare": [
      "K",
      "W",
      "Y"
     ]
    },
    {
     "t": "h",
     "text": "Marks you will see above and below letters"
    },
    {
     "t": "table",
     "head": [
      "Mark",
      "Name",
      "What it does",
      "Example"
     ],
     "rows": [
      [
       "á é í ó ú",
       "acento agudo",
       "stressed, and open",
       "café — coffee"
      ],
      [
       "â ê ô",
       "acento circunflexo",
       "stressed, and closed",
       "você — you"
      ],
      [
       "ã õ",
       "til",
       "nasal — through the nose",
       "irmã — sister"
      ],
      [
       "ç",
       "cedilha",
       "makes c sound like s, before a, o, u",
       "almoço — lunch"
      ],
      [
       "à",
       "crase",
       "the word a merged with another a",
       "à noite — at night"
      ]
     ]
    },
    {
     "t": "h",
     "text": "Two letters, one sound"
    },
    {
     "t": "pairs",
     "rows": [
      [
       "lh",
       "like the lli in million — filho, son"
      ],
      [
       "nh",
       "like the ny in canyon — dinheiro, money"
      ],
      [
       "ch",
       "like sh — chá, tea"
      ],
      [
       "rr",
       "a throaty h in most of Brazil — carro, car"
      ],
      [
       "ss",
       "a hard s between vowels — passo, step"
      ]
     ]
    },
    {
     "t": "callout",
     "text": "An r at the start of a word sounds like rr: rua sounds closer to hua. This is the single most Brazilian thing about Brazilian pronunciation."
    }
   ]
  }
 ]
}